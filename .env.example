# Copy this file to .env.local and fill in ONE email provider.
# Forms will not reach your inbox until a key is set.

# Inbox that should receive quote, subscribe and call-back messages.
# Only used by the Resend path below.
INQUIRY_EMAIL=falcontextilegarments@gmail.com

# Option A — Web3Forms (https://web3forms.com). Easiest, no domain needed.
# The free plan only accepts submissions from the browser, so this key must be
# the NEXT_PUBLIC_ one. Web3Forms keys are meant to be public.
# Messages arrive at the email you registered on web3forms.com.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# Option B — Resend (https://resend.com). Sends from the server.
# On the free plan RESEND_FROM must stay onboarding@resend.dev and mail only
# reaches your Resend account email until you verify a domain.
RESEND_API_KEY=
RESEND_FROM=Falcon Website <onboarding@resend.dev>
